# Copie para .env (nunca versionado) e ajuste. O backend lê estas variáveis do ambiente.

# ── desenvolvimento local (sem Supabase): Postgres do docker-compose + login local ──
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/pitstop_dev
DATABASE_SSL=false
AUTH_PROVIDER=local
# Mínimo de 32 caracteres. Assina tokens de suporte (impersonation) e o login local.
APP_JWT_SECRET=troque-este-segredo-local-de-32-caracteres-ou-mais
CORS_ORIGINS=http://localhost:4200,http://localhost:4300
PORTAL_BASE_URL=http://localhost:4200
LOG_LEVEL=info

# ── staging/produção (Supabase): troque AUTH_PROVIDER e preencha ──
# AUTH_PROVIDER=supabase
# DATABASE_URL=postgres://postgres.<ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:5432/postgres
# DATABASE_SSL=true
# SUPABASE_URL=https://<ref>.supabase.co
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=        # só no backend. Nunca no frontend, nunca no repositório.
# SUPABASE_JWT_SECRET=              # opcional: projetos com segredo HS256 legado; vazio = valida via JWKS
# CORS_ORIGINS=https://app.pitstop.app,https://admin.pitstop.app
# PORTAL_BASE_URL=https://app.pitstop.app

# ── opcionais ──
# PRIVACY_POLICY_VERSION=2026-11
# DPO_CONTACT_EMAIL=                # contato do encarregado (LGPD) exibido na política de privacidade
# FIPE_PLATE_API_URL=               # consulta de veículo por placa; vazio = preenchimento manual
# THROTTLE_DISABLED=true            # apenas para testes automatizados
