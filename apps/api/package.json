{
  "name": "@pitstop/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "node --watch -r ts-node/register/transpile-only src/main.ts",
    "db:migrate": "ts-node --transpile-only scripts/migrate.ts",
    "db:reset": "ts-node --transpile-only scripts/migrate.ts --reset",
    "seed:dev": "ts-node --transpile-only scripts/seed-dev.ts",
    "test": "jest --runInBand",
    "test:unit": "jest --selectProjects unit",
    "test:int": "jest --runInBand --selectProjects integration",
    "test:cov": "jest --runInBand --coverage"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/throttler": "^6.4.0",
    "@pitstop/shared-types": "1.0.0",
    "@supabase/supabase-js": "^2.49.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "helmet": "^8.0.0",
    "jose": "^5.9.6",
    "nestjs-pino": "^4.3.0",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "~7.8.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2"
  }
}
