{
  "name": "pitstop",
  "version": "2.0.0",
  "description": "PitStop — SaaS B2B multi-tenant de gestão para oficinas mecânicas (NestJS + Angular 19 + Supabase).",
  "private": true,
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/api"
  ],
  "scripts": {
    "build:types": "npm run build -w @pitstop/shared-types",
    "build:api": "npm run build:types && npm run build -w @pitstop/api",
    "build:web": "ng build web",
    "build:admin": "ng build admin",
    "build": "npm run build:api && npm run build:web && npm run build:admin",
    "dev:api": "npm run build:types && npm run start:dev -w @pitstop/api",
    "dev:web": "ng serve web --proxy-config apps/web/proxy.conf.json",
    "dev:admin": "ng serve admin --port 4300 --proxy-config apps/admin/proxy.conf.json",
    "db:up": "docker compose up -d db",
    "db:migrate": "npm run db:migrate -w @pitstop/api",
    "db:reset": "npm run db:reset -w @pitstop/api",
    "seed:dev": "npm run seed:dev -w @pitstop/api",
    "test": "npm run build:types && npm test -w @pitstop/api",
    "test:unit": "npm run build:types && npm run test:unit -w @pitstop/api",
    "test:web": "ng test web --watch=false --browsers=ChromeHeadlessCI",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run build:types && tsc -p apps/api/tsconfig.json --noEmit && tsc -p apps/web/tsconfig.app.json --noEmit && tsc -p apps/admin/tsconfig.app.json --noEmit",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run test:web && npm run build:web && npm run build:admin",
    "test:e2e": "node e2e/acceptance.mjs"
  },
  "dependencies": {
    "@angular/cdk": "^19.2.0",
    "@angular/common": "^19.2.0",
    "@angular/compiler": "^19.2.0",
    "@angular/core": "^19.2.0",
    "@angular/forms": "^19.2.0",
    "@angular/platform-browser": "^19.2.0",
    "@angular/router": "^19.2.0",
    "@angular/service-worker": "^19.2.0",
    "rxjs": "~7.8.1",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.2.0",
    "@angular/cli": "^19.2.0",
    "@angular/compiler-cli": "^19.2.0",
    "@angular/platform-browser-dynamic": "^19.2.25",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^22.13.1",
    "angular-eslint": "19.8.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "10.1.8",
    "jasmine-core": "~5.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-jasmine": "~5.1.0",
    "playwright": "^1.63.0",
    "prettier": "3.8.4",
    "typescript": "~5.7.2",
    "typescript-eslint": "8.46.4"
  }
}
